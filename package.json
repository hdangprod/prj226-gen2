{
  "name": "prj226-gen2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint --ext .ts src tests",
    "test": "vitest run",
    "test:persistence": "vitest run --config tests/infrastructure/d1/vitest.config.ts",
    "migrate:local": "WRANGLER_LOG_PATH=.wrangler/logs WRANGLER_SEND_METRICS=false wrangler d1 migrations apply LIAM_DB --local",
    "build": "WRANGLER_LOG_PATH=.wrangler/logs WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --outdir dist",
    "smoke": "vitest run tests/foundation/runtime-smoke.test.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20250828.0",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "eslint": "8.57.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4",
    "wrangler": "4.32.0"
  }
}
